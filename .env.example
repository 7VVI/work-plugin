# Web 面板访问密钥（必填，建议 32 位以上随机字符串）
DOCK_ADMIN_SECRET=change-me-admin-secret

# 扩展同步 API Token（必填，与管理员密钥分开）
DOCK_API_TOKEN=change-me-api-token

# 数据落盘加密密钥；建议独立随机生成：openssl rand -base64 32
DOCK_DATA_KEY=change-me-32-bytes-or-longer-data-key

# 登录会话有效期（天），默认 30；登录后也可在面板中修改
DOCK_SESSION_DAYS=30

# 云端版本历史保留条数，默认 100
DOCK_HISTORY_LIMIT=100

# 通过 HTTPS 反向代理访问时保持 true；本地 HTTP 调试可设为 false
DOCK_COOKIE_SECURE=true

# 面板对外地址，例如 https://dock.example.com；用于 CSRF Origin 校验
DOCK_PUBLIC_ORIGIN=https://dock.example.com

# 反向代理部署时设为 true
DOCK_TRUST_PROXY=true

# 可选：端口与数据库路径（Docker 镜像内默认值）
PORT=8080
DOCK_DB=/data/dock.sqlite
DOCK_WEB_DIST=/app/public

# 可选：数据密钥轮换时填写旧密钥，服务会解密后用新密钥重加密
# DOCK_DATA_KEY_OLD=
