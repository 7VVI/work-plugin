# Web 面板访问密钥（必填，建议 32 位以上随机字符串）
DOCK_ADMIN_SECRET=change-me-admin-secret

# 扩展同步 API Token（必填，与管理员密钥分开）
DOCK_API_TOKEN=change-me-api-token

# 数据落盘加密密钥；建议独立随机生成：openssl rand -base64 32
DOCK_DATA_KEY=change-me-32-bytes-or-longer-data-key

# 登录会话有效期（天），默认 30；登录后也可在面板中修改
DOCK_SESSION_DAYS=30

# 云端版本历史保留条数，默认 100
DOCK_HISTORY_LIMIT=100

# 通过 HTTPS 反向代理访问时保持 true；本地 HTTP 调试可设为 false
DOCK_COOKIE_SECURE=true

# 面板对外地址，例如 https://dock.example.com；用于 CSRF Origin 校验
DOCK_PUBLIC_ORIGIN=https://dock.example.com

# 反向代理部署时设为 true
DOCK_TRUST_PROXY=true

# SSH 终端：服务端作为 SSH 堡垒机，使用云端已同步的服务器密码/私钥建连
# 默认开启；设为 false 可完全关闭 SSH 终端
DOCK_SSH_ENABLED=true
# 全局 / 单服务器并发会话上限
DOCK_SSH_MAX_SESSIONS=8
DOCK_SSH_MAX_PER_SERVER=2
# 空闲断开时间（毫秒），默认 30 分钟
DOCK_SSH_IDLE_MS=1800000
# 一次性 WebSocket 票据有效期（毫秒），默认 30 秒
DOCK_SSH_TICKET_TTL_MS=30000
# SFTP 文件管理（文件树 / 编辑 / 上传下载），默认开启；设为 false 关闭
DOCK_SSH_FS_ENABLED=true
# 单文件在线编辑上限（字节），默认 2MB
DOCK_SSH_FS_MAX_EDIT=2097152
# 单文件上传 / 下载上限（字节），默认 200MB
DOCK_SSH_FS_MAX_TRANSFER=209715200

# 数据库在线管理：服务端代连内网数据库，连接参数取自云端已同步的中间件记录
# 默认开启；设为 false 可完全关闭
DOCK_DB_ENABLED=true
# 全局 / 单中间件并发会话上限
DOCK_DB_MAX_SESSIONS=8
DOCK_DB_MAX_PER_MIDDLEWARE=2
# 空闲断开时间（毫秒），默认 30 分钟
DOCK_DB_IDLE_MS=1800000
# 一次性 WebSocket 票据有效期（毫秒），默认 30 秒
DOCK_DB_TICKET_TTL_MS=30000
# 建连超时（毫秒），默认 8 秒
DOCK_DB_CONNECT_TIMEOUT_MS=8000
# 单条 SQL 超时（毫秒），默认 30 秒
DOCK_DB_QUERY_TIMEOUT_MS=30000
# 单次结果集行数上限，默认 500（硬上限 5000）
DOCK_DB_MAX_ROWS=500
# 单次结果集字节上限，默认 2MB；超出部分截断
DOCK_DB_MAX_RESULT_BYTES=2097152
# 单元格文本截断长度（字节），默认 64KB
DOCK_DB_MAX_TEXT_CELL_BYTES=65536
# 允许访问的 SQLite 目录（逗号分隔），容器内默认 /data/sqlite
DOCK_DB_SQLITE_ROOTS=/data/sqlite
# 只读模式：仅允许 SELECT / SHOW / EXPLAIN，默认 false（允许读写）
DOCK_DB_READ_ONLY=false

# 可选：端口与数据库路径（Docker 镜像内默认值）
PORT=8080
DOCK_DB=/data/dock.sqlite
DOCK_WEB_DIST=/app/public

# 可选：数据密钥轮换时填写旧密钥，服务会解密后用新密钥重加密
# DOCK_DATA_KEY_OLD=
